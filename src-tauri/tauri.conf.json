{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Infiniity DJ",
  "version": "0.1.0",
  "identifier": "com.infiniityeventos.dj",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Infiniity DJ",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Mezclador de musica para eventos",
    "longDescription": "Infiniity DJ: mezclador liviano y estable para operar musica en vivo en eventos sociales. Pensado para hardware de gama baja.",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {}
}
